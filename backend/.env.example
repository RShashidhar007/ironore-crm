# ============================================================
# Iron Ore / Iron Pellet CRM Bot — Backend Configuration
# Copy this file to ".env" and fill in real values.
# ============================================================

# --- Database -------------------------------------------------
# Local development: leave DB_MODE=sqlite
# Production: set DB_MODE=mssql and fill in the SQL Server settings.
DB_MODE=sqlite
SQLITE_PATH=./customer_db.sqlite3

MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=Customer_DB
MSSQL_USER=sa
MSSQL_PASSWORD=change-me
# ODBC Driver 18 for SQL Server must be installed on the host running this backend
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_ENCRYPT=yes
MSSQL_TRUST_SERVER_CERT=yes

# --- Auth -------------------------------------------------------
JWT_SECRET=please-change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# --- Ollama -------------------------------------------------------
# The backend will try to reach Ollama for natural-language phrasing.
# If it is unreachable, the backend falls back to templated responses
# built directly from verified database data (the bot keeps working).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_ENABLED=true
OLLAMA_TIMEOUT_SECONDS=20

# --- Company contact info (never invented by the bot) -------------
COMPANY_WHATSAPP_NUMBER=
COMPANY_SUPPORT_EMAIL=
COMPANY_SUPPORT_PHONE=

# --- CORS -----------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:5173
