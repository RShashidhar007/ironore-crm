# ============================================================
# Iron Ore CRM - MS SQL Server Configuration
# ============================================================
# Copy this file to .env and fill in your actual values

# --- Database Configuration ---------------------------------
DB_MODE=mssql

# SQL Server connection details
# For SQL Server Express with named instance, use: localhost\SQLEXPRESS
# For default instance, use: localhost
MSSQL_SERVER=your_server_name
MSSQL_PORT=
MSSQL_DATABASE=Customer_DB

# SQL Server credentials
MSSQL_USER=your_db_username
MSSQL_PASSWORD=your_db_password

MSSQL_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_ENCRYPT=no
MSSQL_TRUST_SERVER_CERT=yes

# --- Authentication -----------------------------------------
JWT_SECRET=your-random-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# --- Ollama (AI Chat) ---------------------------------------
# Ollama server for AI-powered chat responses
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_ENABLED=true
OLLAMA_TIMEOUT_SECONDS=120

# --- Company Contact Info -----------------------------------
# Contact details displayed in the chat
COMPANY_WHATSAPP_NUMBER=+1234567890
COMPANY_SUPPORT_EMAIL=support@company.com
COMPANY_SUPPORT_PHONE=+1234567890

# --- CORS ---------------------------------------------------
# Frontend origin for CORS policy
FRONTEND_ORIGIN=http://localhost:5173
