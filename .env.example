# ============================================================
# IronOre CRM - Environment Configuration Example
# Copy this file to .env and fill in your actual values
# Do NOT commit .env to git
# ============================================================

# --- Database Configuration ---
# Options: "sqlite" for development, "mssql" for production
DB_MODE=mssql

# SQLite (used when DB_MODE=sqlite)
SQLITE_PATH=./customer_db.sqlite3

# SQL Server Configuration (used when DB_MODE=mssql)
# For named instance: SHASHIDHAR\SQLEXPRESS
# For default instance: localhost
MSSQL_SERVER=localhost
MSSQL_PORT=
MSSQL_DATABASE=Customer_DB
MSSQL_USER=crm_user
MSSQL_PASSWORD=your_secure_password_here
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_ENCRYPT=no
MSSQL_TRUST_SERVER_CERT=yes

# --- Authentication ---
JWT_SECRET=your-random-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# --- Ollama (AI Chat) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_ENABLED=true
OLLAMA_TIMEOUT_SECONDS=120

# --- Company Contact Information ---
COMPANY_WHATSAPP_NUMBER=7022486778
COMPANY_SUPPORT_EMAIL=support@company.com
COMPANY_SUPPORT_PHONE=7022486778

# --- CORS Configuration ---
# When running in Docker, use the appropriate URL
# Local dev: http://localhost:5000
# Docker: http://localhost:5000 or your domain
FRONTEND_ORIGIN=http://localhost:5000
