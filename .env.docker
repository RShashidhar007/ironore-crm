# Docker Environment Configuration - IronOre CRM
# Copy this file to .env before running docker-compose

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_URL=mssql+pyodbc://SA:IronOre@2024!@database:1433/ironore_crm?driver=ODBC+Driver+17+for+SQL+Server
SA_PASSWORD=IronOre@2024!

# ============================================
# BACKEND CONFIGURATION
# ============================================
# JWT Secret Key (change this to a secure random string in production)
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ============================================
# OLLAMA CONFIGURATION (LLM)
# ============================================
# Set to empty string to disable Ollama features
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# ============================================
# EMAIL CONFIGURATION (SMTP)
# ============================================
# Gmail SMTP settings
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your-email@gmail.com
SENDER_PASSWORD=your-app-password

# ============================================
# FRONTEND CONFIGURATION
# ============================================
# API base URL (update if backend is on different host)
VITE_API_BASE_URL=http://localhost:8000

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO

# ============================================
# DEPLOYMENT NOTES
# ============================================
# Before deploying to production:
# 1. Generate a new SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 2. Change SA_PASSWORD to a strong password
# 3. Configure valid SMTP credentials for email
# 4. Update VITE_API_BASE_URL to your production domain
# 5. Use environment variable management (AWS Secrets Manager, Azure Key Vault, etc.)
